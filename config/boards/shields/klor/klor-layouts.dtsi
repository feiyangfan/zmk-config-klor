/*
 * SPDX-License-Identifier: MIT
 * Key positions follow QMK's schematic KLOR LAYOUT (not to physical scale):
 * https://github.com/qmk/qmk_firmware/blob/master/keyboards/geigeigeist/klor/keyboard.json
 * Order matches default_transform, including both encoder push buttons.
 */

#include <physical_layouts.dtsi>

/ {
    klor_layout: klor_layout {
        compatible = "zmk,physical-layout";
        display-name = "KLOR Polydactyl";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys //                     w   h    x    y   rot rx ry
            = <&key_physical_attrs 100 100  100    0 0 0 0> // L01
            , <&key_physical_attrs 100 100  200    0 0 0 0> // L02
            , <&key_physical_attrs 100 100  300    0 0 0 0> // L03
            , <&key_physical_attrs 100 100  400    0 0 0 0> // L04
            , <&key_physical_attrs 100 100  500    0 0 0 0> // L05
            , <&key_physical_attrs 100 100  900    0 0 0 0> // R00
            , <&key_physical_attrs 100 100 1000    0 0 0 0> // R01
            , <&key_physical_attrs 100 100 1100    0 0 0 0> // R02
            , <&key_physical_attrs 100 100 1200    0 0 0 0> // R03
            , <&key_physical_attrs 100 100 1300    0 0 0 0> // R04
            , <&key_physical_attrs 100 100    0  100 0 0 0> // L10
            , <&key_physical_attrs 100 100  100  100 0 0 0> // L11
            , <&key_physical_attrs 100 100  200  100 0 0 0> // L12
            , <&key_physical_attrs 100 100  300  100 0 0 0> // L13
            , <&key_physical_attrs 100 100  400  100 0 0 0> // L14
            , <&key_physical_attrs 100 100  500  100 0 0 0> // L15
            , <&key_physical_attrs 100 100  900  100 0 0 0> // R10
            , <&key_physical_attrs 100 100 1000  100 0 0 0> // R11
            , <&key_physical_attrs 100 100 1100  100 0 0 0> // R12
            , <&key_physical_attrs 100 100 1200  100 0 0 0> // R13
            , <&key_physical_attrs 100 100 1300  100 0 0 0> // R14
            , <&key_physical_attrs 100 100 1400  100 0 0 0> // R15
            , <&key_physical_attrs 100 100    0  200 0 0 0> // L20
            , <&key_physical_attrs 100 100  100  200 0 0 0> // L21
            , <&key_physical_attrs 100 100  200  200 0 0 0> // L22
            , <&key_physical_attrs 100 100  300  200 0 0 0> // L23
            , <&key_physical_attrs 100 100  400  200 0 0 0> // L24
            , <&key_physical_attrs 100 100  500  200 0 0 0> // L25
            , <&key_physical_attrs 100 100  600  200 0 0 0> // L35
            , <&key_physical_attrs 100 100  800  200 0 0 0> // R30
            , <&key_physical_attrs 100 100  900  200 0 0 0> // R20
            , <&key_physical_attrs 100 100 1000  200 0 0 0> // R21
            , <&key_physical_attrs 100 100 1100  200 0 0 0> // R22
            , <&key_physical_attrs 100 100 1200  200 0 0 0> // R23
            , <&key_physical_attrs 100 100 1300  200 0 0 0> // R24
            , <&key_physical_attrs 100 100 1400  200 0 0 0> // R25
            , <&key_physical_attrs 100 100  200  300 0 0 0> // L31
            , <&key_physical_attrs 100 100  300  300 0 0 0> // L32
            , <&key_physical_attrs 100 100  400  300 0 0 0> // L33
            , <&key_physical_attrs 100 100  500  300 0 0 0> // L34
            , <&key_physical_attrs 100 100  900  300 0 0 0> // R31
            , <&key_physical_attrs 100 100 1000  300 0 0 0> // R32
            , <&key_physical_attrs 100 100 1100  300 0 0 0> // R33
            , <&key_physical_attrs 100 100 1200  300 0 0 0> // R34
            ;
    };
};
